#!/usr/bin/env bash
# One-shot setup for the Sharkipedia development environment.
#
# Builds the Docker images, installs Ruby and JS dependencies inside the
# containers, and prepares the development database. Running it a second
# time is safe — every step is idempotent.
#
# Pass --skip-server to stop before starting the dev server.

set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v docker &> /dev/null; then
  echo "Docker is not installed. Install Docker Desktop for Mac first:"
  echo "  https://www.docker.com/products/docker-desktop/"
  exit 1
fi

echo "== Building Docker images =="
docker compose build

echo
echo "== Installing Ruby dependencies =="
docker compose run --rm web bundle install

echo
echo "== Installing JS dependencies =="
docker compose run --rm web yarn install

echo
echo "== Preparing database =="
docker compose run --rm web bin/rails db:prepare

for arg in "$@"; do
  if [ "$arg" = "--skip-server" ]; then
    echo
    echo "== Setup complete. Run bin/dev to start the app. =="
    exit 0
  fi
done

echo
echo "== Starting development server =="
exec bin/dev
